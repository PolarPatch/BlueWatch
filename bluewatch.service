[Unit]
Description=BlueWatch Bluetooth Monitor
After=bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m bluewatch.daemon
Restart=always
RestartSec=10
WatchdogSec=60
Environment=BLUEWATCH_DATA_DIR=/var/lib/bluewatch

[Install]
WantedBy=multi-user.target
